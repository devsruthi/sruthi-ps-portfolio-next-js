# Site URL for SEO (sitemap, canonical, Open Graph). Optional; defaults to https://sruthips.com
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# AWS SES (Contact form)
# For LOCAL development: copy this file to .env.local (Next.js loads .env.local, not .env.example)
# For Vercel: set these in Project → Settings → Environment Variables
AWS_SES_KEY=your_access_key_id
AWS_SES_SECRET=your_secret_access_key
AWS_REGION=us-east-1

# Verified sender email in SES (From address)
CONTACT_FROM_EMAIL=noreply@yourdomain.com
# Where to receive contact form submissions
CONTACT_TO_EMAIL=you@yourdomain.com

# Supabase (contact form submissions stored in table contact_messages)
# Use the secret key only; never expose it to the frontend.
# Dashboard: Project Settings → API → Project URL and Secret key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_secret_key

# Admin area (/admin). Simple password check; session is signed with SESSION_SECRET.
ADMIN_PASSWORD=your_secure_admin_password
# Long random string (e.g. openssl rand -base64 32) to sign admin session cookies.
SESSION_SECRET=your_session_secret_at_least_32_chars
